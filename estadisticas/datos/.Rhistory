Data <- tibble(n = 1:cantidad) %>%
mutate(
theta = n * golden_angle,
r = sqrt(n),
x = r * cos(theta),
y = r * sin(theta)
) %>%
mutate(number = decimales)
View(Data)
Data <- tibble(n = 1:cantidad) %>%
