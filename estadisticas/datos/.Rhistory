# Evolucion
Data2 <- Raw2 %>%
filter(Tipo %in% c("Género", "Familiar", "No penal")) %>%
mutate(Año = as.character(Año)) %>%
group_by(Año, Mes, Mes_ord) %>%
summarise(Cantidad = sum(Cantidad)) %>%
ungroup %>%
rename(Mes_num = "Mes_ord") %>%
mutate(Trimestre = case_when(Mes_num >= 1 & Mes_num <= 3 ~ 1,
