# Librerias
library(jsonlite)
library(dplyr)
library(stringr)
library(readr)
library(googlesheets4)
library(janitor)
library(lubridate)
######### LEER DATOS #########
dir <- dirname(rstudioapi::getActiveDocumentContext()$path)
planilla <- "https://docs.google.com/spreadsheets/d/1fX8iWndJKs_UTTcB1SoU5tpTK7ysVvxJeyVAE0C5gro/edit?usp=sharing"
Raw1 <- read_sheet(ss=planilla, sheet="Mes")
Raw2 <- read_sheet(ss=planilla, sheet="Dia")
Raw3 <- read_sheet(ss=planilla, sheet="Hora")
######### DICCIONARIOS #########
Dias <- data.frame(Dia = c("Lunes", "Martes", "Miércoles", "Jueves",
"Viernes", "Sábado", "Domingo"),
Dia_num = 1:7)
Meses <- data.frame(Mes = c("Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
"Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"),
Mes_num = 1:12)
######### TRANSFORMAR DATOS #########
# Evolución
Data1 <- Raw1 %>%
filter(Tipo != "Abuso sexual") %>%
mutate(Año = as.character(Año)) %>%
group_by(Mes, Año) %>%
summarise(Cantidad = sum(Cantidad)) %>%
left_join(Meses, by="Mes") %>%
mutate(Trimestre=case_when(Mes_num >= 1 & Mes_num <= 3 ~ 1,
Mes_num >= 4 & Mes_num <= 6 ~ 2,
Mes_num >= 7 & Mes_num <= 9 ~ 3,
Mes_num >= 10 & Mes_num <= 12 ~ 4),
Semestre = case_when(Mes_num >= 1 & Mes_num <= 6 ~ 1,
Mes_num >= 7 & Mes_num <= 12 ~ 2),
year_mes=paste0(sprintf("%02d", Mes_num),"-",str_sub(Año,3,4)),
year_trimestre=paste0(sprintf("%02d", Trimestre), "-", str_sub(Año, 3, 4)),
year_semestre=paste0(sprintf("%02d",Semestre), "-", str_sub(Año,3,4))) %>%
rbind(data.frame(Mes=c("Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"),
Año="2023",
Cantidad = NA,
Mes_num = 7:12,
Trimestre = rep(c(3, 4), each=3),
Semestre = 2) %>%
mutate(year_mes = paste0(sprintf("%02d", Mes_num), "-", str_sub(Año, 3,4)),
year_trimestre=paste0(sprintf("%02d", Trimestre), "-", str_sub(Año, 3, 4)),
year_semestre=paste0(sprintf("%02d",Semestre), "-", str_sub(Año,3,4)))) %>%
arrange(Año, Mes_num)
# Por mes
Data2 <- Raw1 %>%
left_join(Meses, by="Mes") %>%
filter(Tipo != "Abuso sexual") %>%
mutate(Año = as.character(Año)) %>%
group_by(Año, Mes, Mes_num) %>%
summarise(Cantidad = sum(Cantidad)) %>%
arrange(Año, Mes_num) %>%
ungroup %>%
mutate(Fecha = make_date(Año, Mes_num, 1))
# Tipo de violencia y accion
Data3 <- Raw1 %>%
filter(Tipo != "Abuso sexual") %>%
mutate(Año = as.character(Año)) %>%
group_by(Año, Accion, Tipo) %>%
summarise(Cantidad = sum(Cantidad)) %>%
ungroup %>%
mutate(Accion_ord = case_when(Accion == "Llamadas" ~ 1,
Accion == "Intervenciones" ~ 2,
Accion == "Intervenciones SAMEC" ~ 3)) %>%
arrange(Año, Accion_ord)
# Requerimientos por dia
Data4 <- Raw2 %>%
left_join(Meses, by="Mes") %>%
left_join(Dias, by="Dia") %>%
filter(Tipo != "Abuso sexual") %>%
mutate(Año = as.character(Año)) %>%
group_by(Año, Mes, Mes_num, Dia, Dia_num) %>%
summarise(Cantidad = sum(Cantidad)) %>%
arrange(Año, desc(Mes_num), Dia_num)
# Requerimientos por dia
Data4 <- Raw2 %>%
left_join(Dias, by="Dia") %>%
mutate(Año = as.character(Año)) %>%
group_by(Año, Accion, Dia, Dia_num) %>%
summarise(Cantidad = sum(Cantidad)) %>%
arrange(Año, Accion, Dia_num)
# Requerimientos por hora
Data5 <- Raw3 %>%
mutate(Año = as.character(Año),
Hora = formatC(Hora, width=2, flag="0")) %>%
group_by(Año, Accion, Hora) %>%
summarise(Cantidad = sum(Cantidad)) %>%
arrange(Año, Accion, Hora)
######### ACTUALIZACIÓN #########
actualizacion <- paste0("Última actualización de los datos de esta sección: ", format(Sys.Date(), "%d/%m/%Y"))
writeLines(actualizacion, paste0(dir, "/json/actualizacion_requerimientos_911.txt"))
######### ESCRIBIR DATOS #########
write_json(toJSON(Data1), path = paste0(dir, "/json/denuncias_911_evolucion.json"), na = "null")
write_json(toJSON(Data2), path = paste0(dir, "/json/denuncias_911_por_mes.json"))
write_json(toJSON(Data3), path = paste0(dir, "/json/denuncias_911_violencia_accion.json"))
write_json(toJSON(Data4), path = paste0(dir, "/json/denuncias_911_dia.json"))
write_json(toJSON(Data5), path = paste0(dir, "/json/denuncias_911_hora.json"))
View(Data2)
View(Data1)
View(Data2)
View(Data3)
View(Data3)
source("C:/PÁGINA WEB/Pagina-Web-OVcM/estadisticas/datos/calculo_denuncias_911.R", echo = TRUE)
View(Data4)
colnames(Data4)
min(Data4$Cantidad)
max(Data4$Cantidad)
# Requerimientos por dia
Data4 <- Raw2 %>%
filter(Accion != "Llamadas SAMEC") %>%
left_join(Dias, by="Dia") %>%
mutate(Año = as.character(Año)) %>%
group_by(Año, Accion, Dia, Dia_num) %>%
summarise(Cantidad = sum(Cantidad)) %>%
group_by(Año, Accion) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
arrange(Año, Accion, Dia_num)
View(Data4)
# Requerimientos por hora
Data5 <- Raw3 %>%
filter(Accion != "Llamadas SAMEC") %>%
mutate(Año = as.character(Año),
Hora = formatC(Hora, width=2, flag="0")) %>%
group_by(Año, Accion, Hora) %>%
summarise(Cantidad = sum(Cantidad)) %>%
group_by(Año, Accion) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
arrange(Año, Accion, Hora)
######### ACTUALIZACIÓN #########
actualizacion <- paste0("Última actualización de los datos de esta sección: ", format(Sys.Date(), "%d/%m/%Y"))
writeLines(actualizacion, paste0(dir, "/json/actualizacion_requerimientos_911.txt"))
######### ESCRIBIR DATOS #########
write_json(toJSON(Data1), path = paste0(dir, "/json/denuncias_911_evolucion.json"), na = "null")
write_json(toJSON(Data2), path = paste0(dir, "/json/denuncias_911_por_mes.json"))
write_json(toJSON(Data3), path = paste0(dir, "/json/denuncias_911_violencia_accion.json"))
write_json(toJSON(Data4), path = paste0(dir, "/json/denuncias_911_dia.json"))
write_json(toJSON(Data5), path = paste0(dir, "/json/denuncias_911_hora.json"))
View(Data4)
min(Data$Porcentaje)
min(Data4$Porcentaje)
max(Data4$Porcentaje)
min(Data5$Porcentaje)
